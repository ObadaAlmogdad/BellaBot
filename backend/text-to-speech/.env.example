# ============================================
# Local TTS Backend Environment Variables
# ============================================
# انسخ هذا الملف إلى .env وعدل القيم حسب الحاجة

# منفذ تشغيل واجهة برمجة التطبيقات (API) المحلية
TTS_API_PORT=8000

# جهاز تشغيل النموذج:
#   cuda  -> لتسريع GPU (NVIDIA CUDA) - مستحسن إذا توفر
#   cpu   -> للمعالج (أبطأ لكن يعمل على أي جهاز)
DEVICE=cuda

# المسار الكامل أو النسبي لمجلد التخزين المحلي للملفات الصوتية
# يتم إنشاء المجلد تلقائياً إذا لم يكن موجوداً
STORAGE_PATH=./storage

# العنوان الأساسي لواجهة برمجة التطبيقات (يُستخدم لبناء الروابط)
TTS_API_BASE_URL=http://localhost:8000
